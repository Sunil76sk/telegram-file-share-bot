# Telegram Bot API Credentials (REQUIRED)
API_ID=your_api_id
API_HASH=your_api_hash
BOT_TOKEN=your_bot_token

# MongoDB Credentials (REQUIRED)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=ClusterName
DB_NAME=tg_file_share_bot

# Administrators (comma-separated Telegram user IDs)
ADMIN_IDS=123456789

# Force Subscription Channels (comma-separated channel IDs or @usernames)
FORCE_SUB_CHATS=-1001234567890

# File Auto-Delete Delay (seconds, default: 300)
AUTO_DELETE_SECONDS=300

# URL Shortener API (optional – for monetization)
SHORTENER_API_URL=https://your-shortener.com/api
SHORTENER_API_KEY=your_shortener_api_key

# Redirect Web Server URL (change to your public URL in production)
REDIRECT_BASE_URL=http://localhost:8080

# Premium Tiers (Telegram Stars pricing)
PREMIUM_SILVER_WEEKLY=75
PREMIUM_SILVER_MONTHLY=200
PREMIUM_GOLD_WEEKLY=150
PREMIUM_GOLD_MONTHLY=400
PREMIUM_GOLD_LIFETIME=1500

# UPI Payment Settings
UPI_ID=merchant@upi
UPI_QR_IMAGE=

# SaaS Plan Pricing (INR)
SAAS_STARTER_PRICE=999
SAAS_PRO_PRICE=2499
SAAS_AGENCY_PRICE=4999

# Web Server Port
WEB_SERVER_PORT=8080
